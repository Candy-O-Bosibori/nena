DATABASE_URL=postgresql://nena_user:nena_password@localhost:5432/nena
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
FLASK_APP=app.py
FLASK_ENV=development
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
# OAuth 2.0 Client ID from Google Cloud Console (must match the frontend's
# VITE_GOOGLE_CLIENT_ID — the backend verifies tokens against this audience).
GOOGLE_CLIENT_ID=
TRANSCRIPTION_LANGUAGE=en
# Comma-separated allowed frontend origins for CORS. Leave unset locally
# (defaults to *); set explicitly in production, e.g.:
# CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=
